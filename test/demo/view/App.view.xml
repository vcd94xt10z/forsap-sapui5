<mvc:View
    controllerName="demo.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:forsap="forsap"
    height="100%">

    <Page height="100%">
        <customHeader>
            <Toolbar>
                <HBox width="100%" class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                    <Title text="forsap - Controles" />
                </HBox>
            </Toolbar>
        </customHeader>
        <content>
            <VBox class="sapUiMediumMargin">
                <Title text="IntegerInput" level="H2" />

                <Label
                    text="Somente números inteiros"
                    class="sapUiSmallMarginTop" />

                <forsap:IntegerInput
                    id="integerInput"
                    width="100%"
                    placeholder="Digite um inteiro" />

                <Text
                    text="{= 'Valor: ' + ${/integerValue} }"
                    class="sapUiSmallMarginTop" />

                <Title
                    text="DecimalInput"
                    level="H2"
                    class="sapUiLargeMarginTop" />

                <Label
                    text="2 casas decimais"
                    class="sapUiSmallMarginTop" />

                <forsap:DecimalInput
                    id="decimalInput2"
                    width="100%"
                    decimalPlaces="2"
                    placeholder="Ex.: 123,45" />

                <Text
                    text="{= 'Valor: ' + ${/decimalValue2} }"
                    class="sapUiSmallMarginTop" />

                <Label
                    text="3 casas decimais"
                    class="sapUiMediumMarginTop" />

                <forsap:DecimalInput
                    id="decimalInput3"
                    width="100%"
                    decimalPlaces="3"
                    placeholder="Ex.: 123,456" />

                <Text
                    text="{= 'Valor: ' + ${/decimalValue3} }"
                    class="sapUiSmallMarginTop" />

                <Title
                    text="VendorInput"
                    level="H2"
                    class="sapUiLargeMarginTop" />

                <Label
                    text="Fornecedor - modo de teste"
                    class="sapUiSmallMarginTop" />

                <forsap:VendorInput
                    id="vendorInput"
                    width="100%"
                    testMode="true"
                    value="{/Supplier}"
                    placeholder="Selecione o fornecedor..." />

                <Text
                    text="{= 'Fornecedor selecionado: ' + ${/Supplier} }"
                    class="sapUiSmallMarginTop" />

                <Title
                    text="Exemplos"
                    level="H2"
                    class="sapUiLargeMarginTop" />

                <Text text="IntegerInput: 123, -123" />
                <Text text="DecimalInput: 123,45 ou 123.45" />
                <Text text="VendorInput: abre o Value Help com 5 fornecedores em testMode." />
            </VBox>
        </content>
    </Page>
</mvc:View>
